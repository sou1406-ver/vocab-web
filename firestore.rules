rules_version = '2';
// users/{uid}/sync/state: version, revision, generation, latestId, updatedAt.
// users/{uid}/changes/{id}: immutable ordered operation metadata.
// users/{uid}/changes/{id}/chunks/{index}: immutable JSON payload fragments.
// users paths are private to the authenticated UID.
// profiles/{uid}: version, username, hiddenLeaderboard, updatedAt (owner only).
// usernames/{name}: immutable {uid} reservation; claimed/renamed atomically with profiles.
// leaderboard/{uid}: username, avatar, learnedCount, version, updatedAt only.
// Summaries are visible to signed-in users; only their owner can publish/delete.
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) { return request.auth != null && request.auth.uid == uid; }
    function profile(uid) { return /databases/$(database)/documents/profiles/$(uid); }
    function username(name) { return /databases/$(database)/documents/usernames/$(name); }
    function ranking(uid) { return /databases/$(database)/documents/leaderboard/$(uid); }
    function validUsername(name) { return name is string && name.matches('^[a-z0-9_]{3,20}$'); }
    function complete(uid) {
      return exists(profile(uid)) && validUsername(get(profile(uid)).data.username)
        && exists(username(get(profile(uid)).data.username))
        && get(username(get(profile(uid)).data.username)).data.uid == uid;
    }
    function namedOwner(uid) { return owner(uid) && complete(uid); }
    function validProfile(uid) {
      let d = request.resource.data;
      return d.keys().hasAll(['version', 'username', 'hiddenLeaderboard', 'updatedAt'])
        && d.keys().hasOnly(['version', 'username', 'hiddenLeaderboard', 'updatedAt'])
        && d.version == 1 && validUsername(d.username) && d.hiddenLeaderboard is bool
        && d.updatedAt is timestamp && d.updatedAt == request.time
        && getAfter(username(d.username)).data.uid == uid
        && (!exists(profile(uid)) || get(profile(uid)).data.username == d.username
          || !existsAfter(username(get(profile(uid)).data.username)))
        && (d.hiddenLeaderboard ? !existsAfter(ranking(uid))
          : (!existsAfter(ranking(uid)) || getAfter(ranking(uid)).data.username == d.username));
    }
    function validCultivator(uid) {
      let d = request.resource.data;
      let p = getAfter(profile(uid)).data;
      return d.keys().hasAll(['version', 'username', 'avatar', 'learnedCount', 'updatedAt'])
        && d.keys().hasOnly(['version', 'username', 'avatar', 'learnedCount', 'updatedAt'])
        && d.version == 1 && validUsername(d.username)
        && p.username == d.username && p.hiddenLeaderboard == false
        && getAfter(username(d.username)).data.uid == uid
        && d.avatar is int && d.avatar >= 0 && d.avatar < 20
        && d.learnedCount is int && d.learnedCount >= 0 && d.learnedCount <= 100000
        && d.updatedAt is timestamp && d.updatedAt == request.time;
    }
    function head(uid) { return /databases/$(database)/documents/users/$(uid)/sync/state; }
    function entry(uid, id) { return /databases/$(database)/documents/users/$(uid)/changes/$(id); }
    function validHead(uid) {
      let d = request.resource.data;
      let op = getAfter(entry(uid, d.latestId)).data;
      return d.keys().hasAll(['version', 'revision', 'generation', 'latestId', 'updatedAt'])
        && d.keys().hasOnly(['version', 'revision', 'generation', 'latestId', 'updatedAt'])
        && d.version == 1 && d.revision is int && d.revision > 0
        && d.generation is string && d.generation.size() > 0 && d.generation.size() <= 128
        && d.latestId is string && d.latestId.size() > 0 && d.latestId.size() <= 128
        && d.updatedAt == request.time && op.order == d.revision
        && !exists(entry(uid, d.latestId))
        && d.generation == (op.kind == 'restore' ? d.latestId : op.generation);
    }
    function validEntry(uid, id) {
      let d = request.resource.data;
      let h = getAfter(head(uid)).data;
      return d.keys().hasAll(['version', 'deviceId', 'generation', 'kind', 'order', 'at', 'parts'])
        && d.keys().hasOnly(['version', 'deviceId', 'generation', 'kind', 'order', 'at', 'parts'])
        && id.size() > 0 && id.size() <= 128 && d.version == 1
        && d.deviceId is string && d.deviceId.size() > 0 && d.deviceId.size() <= 128
        && d.generation is string && d.generation.size() > 0 && d.generation.size() <= 128
        && d.kind in ['patch', 'import', 'restore'] && d.order is int && d.order > 0
        && d.at == request.time && d.parts is int && d.parts >= 1 && d.parts <= 100
        && h.latestId == id && h.revision == d.order
        && h.generation == (d.kind == 'restore' ? id : d.generation)
        && (exists(head(uid)) ? d.generation == get(head(uid)).data.generation : d.generation == 'initial');
    }
    function validChunk(uid, id, index) {
      let d = request.resource.data;
      return d.keys().hasAll(['payload']) && d.keys().hasOnly(['payload'])
        && d.payload is string && d.payload.size() > 0 && d.payload.size() <= 150000
        && index.matches('^[0-9]{1,3}$') && int(index) < getAfter(entry(uid, id)).data.parts
        && !exists(entry(uid, id));
    }
    match /profiles/{uid} {
      allow get: if owner(uid);
      allow create, update: if owner(uid) && validProfile(uid);
    }
    match /usernames/{name} {
      allow get: if request.auth != null;
      allow create: if request.auth != null && validUsername(name)
        && request.resource.data.keys().hasAll(['uid']) && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid && !exists(username(name))
        && getAfter(profile(request.auth.uid)).data.username == name;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid
        && getAfter(profile(request.auth.uid)).data.username != name;
    }
    match /leaderboard/{uid} {
      allow get: if owner(uid) || (request.auth != null && complete(request.auth.uid));
      allow list: if request.auth != null && complete(request.auth.uid) && request.query.limit != null && request.query.limit <= 50;
      allow create, update: if owner(uid) && validCultivator(uid);
      allow delete: if owner(uid) && getAfter(profile(uid)).data.hiddenLeaderboard == true;
    }
    match /users/{uid}/sync/state {
      allow read: if namedOwner(uid);
      allow create: if namedOwner(uid) && validHead(uid) && request.resource.data.revision == 1;
      allow update: if namedOwner(uid) && validHead(uid) && request.resource.data.revision == resource.data.revision + 1;
    }
    match /users/{uid}/changes/{id} {
      allow read: if namedOwner(uid);
      allow create: if namedOwner(uid) && validEntry(uid, id);
      match /chunks/{index} {
        allow read: if namedOwner(uid);
        allow create: if namedOwner(uid) && validChunk(uid, id, index);
      }
    }
  }
}
