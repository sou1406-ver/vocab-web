# Optional canonical public origin. Set only after the actual deployment domain is known.
# Leave empty for local/temporary preview; do not invent a production URL.
SITE_URL=

# Google Auth and Firestore use the public web config for vocab-web-next.
# Optional API-key override; never put service-account keys in NEXT_PUBLIC_*.
NEXT_PUBLIC_FIREBASE_API_KEY=
# Local emulator testing only. Leave unset on Vercel and normal local runs.
# NEXT_PUBLIC_FIREBASE_EMULATORS=1
