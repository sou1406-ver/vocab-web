{"lessonId":15,"version":"aef0e5fca4b6","questions":[{"kind":"word-form-choice","sourceId":"v1:part5:15:10","wordId":"achievement-15","prompt":"When he thought about his long career, he realized that his biggest ________ was in developing the new leaders of the","answer":"achievement","options":["achiever","achieved","achievement","achieves"],"sourceVersion":"aef0e5fca4b6"},{"kind":"word-form-choice","sourceId":"v1:part5:15:11","wordId":"contribute-15","prompt":"She has ________ so much time and energy to the project that her name should appear on the award.","answer":"contributed","options":["contributes","contribution","contributed","contributor"],"sourceVersion":"aef0e5fca4b6"},{"kind":"word-form-choice","sourceId":"v1:part5:15:13","wordId":"loyal-15","prompt":"There is no reason to question her ________ to our company.","answer":"loyalty","options":["loyal","loyally","loyalty","laurels"],"sourceVersion":"aef0e5fca4b6"},{"kind":"word-form-choice","sourceId":"v1:part5:15:14","wordId":"productive-15","prompt":"These microchips are ________ faster and more cheaply in Asia.","answer":"produced","options":["produce","produced","product","production"],"sourceVersion":"aef0e5fca4b6"},{"kind":"word-form-choice","sourceId":"v1:part5:15:15","wordId":"promote-15","prompt":"Because you are a valued and dedicated employee, we are ________ you to director of the department.","answer":"promoting","options":["promoting","promote","promotion","promoter"],"sourceVersion":"aef0e5fca4b6"},{"kind":"cloze-choice","sourceId":"catalog:example:contribute-15:1","wordId":"contribute-15","prompt":"All employees are asked to ________ a few minutes of their spare time to clean up the office.","answer":"contribute","options":["contribute","look forward to","look to","promote"],"sourceVersion":"aef0e5fca4b6"},{"kind":"cloze-choice","sourceId":"catalog:example:dedication-15:0","wordId":"dedication-15","prompt":"The director's ________ to a high-quality product has motivated many of his employees.","answer":"dedication","options":["dedication","achievement","merit","recognition"],"sourceVersion":"aef0e5fca4b6"},{"kind":"cloze-choice","sourceId":"catalog:example:look-forward-to-15:1","wordId":"look-forward-to-15","prompt":"We ________ seeing you at the next meeting.","answer":"look forward to","options":["look forward to","contribute","promote","value"],"sourceVersion":"aef0e5fca4b6"},{"kind":"cloze-choice","sourceId":"catalog:example:merit-15:0","wordId":"merit-15","prompt":"Employees are evaluated on their ________ and not on seniority.","answer":"merit","options":["merit","achievement","dedication","recognition"],"sourceVersion":"aef0e5fca4b6"},{"kind":"cloze-choice","sourceId":"catalog:example:promote-15:0","wordId":"promote-15","prompt":"Even though the sales associate had a good year, it wasn't possible to ________ him.","answer":"promote","options":["promote","contribute","look forward to","look to"],"sourceVersion":"aef0e5fca4b6"},{"kind":"cloze-choice","sourceId":"catalog:example:recognition-15:0","wordId":"recognition-15","prompt":"The president's personal assistant was finally given the ________ that she has deserved for many years.","answer":"recognition","options":["recognition","achievement","dedication","merit"],"sourceVersion":"aef0e5fca4b6"},{"kind":"cloze-choice","sourceId":"catalog:example:value-15:0","wordId":"value-15","prompt":"Employees ________ their colleagues' opinions.","answer":"value","options":["value","contribute","look forward to","look to"],"sourceVersion":"aef0e5fca4b6"}]}
