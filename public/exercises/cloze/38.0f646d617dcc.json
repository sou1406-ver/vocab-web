{"lessonId":38,"version":"0f646d617dcc","questions":[{"kind":"word-form-choice","sourceId":"v1:part5:38:10","wordId":"comprehensive-38","prompt":"Do you have a ________ map that shows all the station stops west of the Mississippi?","answer":"comprehensive","options":["comprehension","comprehensively","comprehensive","comprehensiveness"],"sourceVersion":"0f646d617dcc"},{"kind":"word-form-choice","sourceId":"v1:part5:38:11","wordId":"directory-38","prompt":"We got lost in the train station and had to ask for ________ to the gate that our train was leaving from.","answer":"directions","options":["directions","directed","directory","directs"],"sourceVersion":"0f646d617dcc"},{"kind":"word-form-choice","sourceId":"v1:part5:38:12","wordId":"operate-38","prompt":"The train has stopped because of a malfunction, but we expect it to be ________ again within minutes.","answer":"operational","options":["operational","operate","operation","operationally"],"sourceVersion":"0f646d617dcc"},{"kind":"word-form-choice","sourceId":"v1:part5:38:13","wordId":"punctually-38","prompt":"John never arrives ________, so I am always anxious when we travel together for fear of missing a train.","answer":"punctually","options":["punctualness","punctually","punctual","punctuality"],"sourceVersion":"0f646d617dcc"},{"kind":"word-form-choice","sourceId":"v1:part5:38:14","wordId":"remainder-38","prompt":"Sylvia's family ________ with her in the station until she was ready to board the train.","answer":"remained","options":["remains","remainder","remained","remaining"],"sourceVersion":"0f646d617dcc"},{"kind":"word-form-choice","sourceId":"v1:part5:38:15","wordId":"remote-38","prompt":"With this traffic, there isn't even a ________ chance that we will get to the train station on time.","answer":"remote","options":["remotely","remote","remoteness","remotest"],"sourceVersion":"0f646d617dcc"},{"kind":"cloze-choice","sourceId":"catalog:example:comprehensive-38:0","wordId":"comprehensive-38","prompt":"The conductor has a ________ knowledge of rail systems from all over the world.","answer":"comprehensive","options":["comprehensive","advanced","valid","equivalent"],"sourceVersion":"0f646d617dcc"},{"kind":"cloze-choice","sourceId":"catalog:example:deluxe-38:0","wordId":"deluxe-38","prompt":"My parents decided to splurge on ________ accommodations for their trip.","answer":"deluxe","options":["deluxe","busy","substantially","valid"],"sourceVersion":"0f646d617dcc"},{"kind":"cloze-choice","sourceId":"catalog:example:directory-38:0","wordId":"directory-38","prompt":"We consulted the ________ to see where the train station was located.","answer":"directory","options":["directory","thrill","excursion","agent"],"sourceVersion":"0f646d617dcc"},{"kind":"cloze-choice","sourceId":"catalog:example:duration-38:0","wordId":"duration-38","prompt":"Mother lent me her spare jacket for the ________ of the trip.","answer":"duration","options":["duration","license","thrill","tier"],"sourceVersion":"0f646d617dcc"},{"kind":"cloze-choice","sourceId":"catalog:example:fare-38:0","wordId":"fare-38","prompt":"The train ________ has increased since I rode last.","answer":"fare","options":["fare","confusion","situation","tier"],"sourceVersion":"0f646d617dcc"},{"kind":"cloze-choice","sourceId":"catalog:example:offset-38:0","wordId":"offset-38","prompt":"The high cost of the hotel room ________ the savings we made by taking the train instead of the plane.","answer":"offset","options":["offset","delay","deal with","economize"],"sourceVersion":"0f646d617dcc"},{"kind":"cloze-choice","sourceId":"catalog:example:remainder-38:0","wordId":"remainder-38","prompt":"The Alaskan frontier has train service in the summer, but for the ________ of the year the tracks are impassable.","answer":"remainder","options":["remainder","system","destination","directory"],"sourceVersion":"0f646d617dcc"},{"kind":"cloze-choice","sourceId":"catalog:example:remote-38:0","wordId":"remote-38","prompt":"I was surprised to find train service to such a ________ location.","answer":"remote","options":["remote","optional","deluxe","equivalent"],"sourceVersion":"0f646d617dcc"}]}
