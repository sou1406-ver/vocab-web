{"lessonId":34,"version":"f8e126790ca2","questions":[{"kind":"word-form-choice","sourceId":"v1:part5:34:10","wordId":"accustom-to-34","prompt":"Susannah is having a hard time becoming ________ to the long hours of her job at the restaurant.","answer":"accustomed to","options":["custom","customs","accustoms to","accustomed to"],"sourceVersion":"f8e126790ca2"},{"kind":"word-form-choice","sourceId":"v1:part5:34:11","wordId":"apprentice-34","prompt":"The student accepted a six-month ________ with a famous chef.","answer":"apprenticeship","options":["apprentice","apprenticed","apprenticing","apprenticeship"],"sourceVersion":"f8e126790ca2"},{"kind":"word-form-choice","sourceId":"v1:part5:34:12","wordId":"demand-34","prompt":"The patrons at this restaurant are often ________ but they usually tip well.","answer":"demanding","options":["demands","demanded","demanding","demand"],"sourceVersion":"f8e126790ca2"},{"kind":"word-form-choice","sourceId":"v1:part5:34:13","wordId":"incorporate-34","prompt":"I love this chef's cooking style, which ________ so many different tastes,","answer":"incorporates","options":["incorporation","incorporates","incorporating","incorporator"],"sourceVersion":"f8e126790ca2"},{"kind":"word-form-choice","sourceId":"v1:part5:34:14","wordId":"method-34","prompt":"The experienced chef was ________ about the way he prepared his award-winning dish.","answer":"methodical","options":["method","methodical","methodically","methodology"],"sourceVersion":"f8e126790ca2"},{"kind":"word-form-choice","sourceId":"v1:part5:34:15","wordId":"profession-34","prompt":"The ________ attitude of the staff is one of the keys to a restaurant's success.","answer":"professional","options":["professional","professionalism","profession","professionally"],"sourceVersion":"f8e126790ca2"},{"kind":"cloze-choice","sourceId":"catalog:example:apprentice-34:0","wordId":"apprentice-34","prompt":"Instead of attending cooking school, Raul chose to work as an ________ with an experienced chef