{"lessonId":28,"version":"f9a032f2fde4","questions":[{"kind":"word-form-choice","sourceId":"v1:part5:28:10","wordId":"defect-28","prompt":"________ equipment on a new car is not only costly, but also dangerous.","answer":"Defective","options":["Defect","Defector","Defective","Defection"],"sourceVersion":"f9a032f2fde4"},{"kind":"word-form-choice","sourceId":"v1:part5:28:11","wordId":"inspect-28","prompt":"Rebecca is known as ________ #321 among her quality control coworkers.","answer":"inspector","options":["inspect","inspection","inspector","inspecting"],"sourceVersion":"f9a032f2fde4"},{"kind":"word-form-choice","sourceId":"v1:part5:28:12","wordId":"perceptive-28","prompt":"An employee who ________ his job as important performs better than one who wants only a paycheck.","answer":"perceives","options":["perceives","perceived","perceptive","perception"],"sourceVersion":"f9a032f2fde4"},{"kind":"word-form-choice","sourceId":"v1:part5:28:13","wordId":"repel-28","prompt":"Agnes was ________ by the odor of the waterproofing.","answer":"repelled","options":["repel","repellent","repelled","repelling"],"sourceVersion":"f9a032f2fde4"},{"kind":"word-form-choice","sourceId":"v1:part5:28:14","wordId":"uniformly-28","prompt":"Standardized products are ________ in appearance.","answer":"uniform","options":["uniforms","uniformly","uniform","unformed"],"sourceVersion":"f9a032f2fde4"},{"kind":"word-form-choice","sourceId":"v1:part5:28:15","wordId":"wrinkle-28","prompt":"Sarah wants to return her dress to the store because it ________ too easily.","answer":"wrinkles","options":["wrinkles","wrinkly","wrinkle","wrinkling"],"sourceVersion":"f9a032f2fde4"},{"kind":"cloze-choice","sourceId":"catalog:example:conform-28:0","wordId":"conform-28","prompt":"The quality control manager insisted that every product that left the plant ________ to the company's rigorous standards.","answer":"conform","options":["conform","enhance","inspect","repel"],"sourceVersion":"f9a032f2fde4"},{"kind":"cloze-ch