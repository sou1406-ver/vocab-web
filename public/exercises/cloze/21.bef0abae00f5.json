{"lessonId":21,"version":"bef0abae00f5","questions":[{"kind":"word-form-choice","sourceId":"v1:part5:21:10","wordId":"accept-21","prompt":"I'm going to call the bank manager ahead of time to make certain that she will ________ a personal check to start a new account.","answer":"accept","options":["accept","accepted","acceptance","acceptable"],"sourceVersion":"bef0abae00f5"},{"kind":"word-form-choice","sourceId":"v1:part5:21:11","wordId":"cautiously-21","prompt":"We felt ________ about applying for such a large loan.","answer":"cautious","options":["cautiously","caution","cautioning","cautious"],"sourceVersion":"bef0abae00f5"},{"kind":"word-form-choice","sourceId":"v1:part5:21:12","wordId":"deduct-21","prompt":"Every month my automatic car loan payment shows up as a ________ on my monthly statement.","answer":"deduction","options":["deduct","deduction","deducting","deducted"],"sourceVersion":"bef0abae00f5"},{"kind":"word-form-choice","sourceId":"v1:part5:21:13","wordId":"restricted-21","prompt":"The number of withdrawals at no charge from your savings account is ________ to three.","answer":"restricted","options":["restricting","restricted","restrict","restriction"],"sourceVersion":"bef0abae00f5"},{"kind":"word-form-choice","sourceId":"v1:part5:21:14","wordId":"signature-21","prompt":"There is a counter in the bank lobby where customers can ________ their documents.","answer":"sign","options":["signing","signed","sign","signature"],"sourceVersion":"bef0abae00f5"},{"kind":"word-form-choice","sourceId":"v1:part5:21:15","wordId":"transaction-21","prompt":"These ________ must be completed before the close of business today.","answer":"transactions","options":["transacts","transacting","transacted","transactions"],"sourceVersion":"bef0abae00f5"},{"kind":"cloze-choice","sourceId":"catalog:example:balance-21:0","wordId":"balance-21","prompt":"His healthy bank ________ showed a long habit of savings.","answer":"balance","options":["balance","dividend","down payment","mortgag