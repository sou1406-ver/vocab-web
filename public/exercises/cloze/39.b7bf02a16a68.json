{"lessonId":39,"version":"b7bf02a16a68","questions":[{"kind":"word-form-choice","sourceId":"v1:part5:39:10","wordId":"advanced-39","prompt":"We paid a lot of money for this room and we expect an ________ level of service.","answer":"advanced","options":["advance","advances","advanced","advancing"],"sourceVersion":"b7bf02a16a68"},{"kind":"word-form-choice","sourceId":"v1:part5:39:11","wordId":"confirm-39","prompt":"Gladys ________ her reservation by calling in advance.","answer":"confirmed","options":["confirmation","confirmed","confirming","confirmative"],"sourceVersion":"b7bf02a16a68"},{"kind":"word-form-choice","sourceId":"v1:part5:39:12","wordId":"expect-39","prompt":"The Chamber of Commerce had high ________ for the amount of business the new hotel would bring to the town.","answer":"expectations","options":["expectancy","expected","expect","expectations"],"sourceVersion":"b7bf02a16a68"},{"kind":"word-form-choice","sourceId":"v1:part5:39:13","wordId":"notify-39","prompt":"The hotel received the ________ of our early arrival and had everything ready for us.","answer":"notification","options":["notified","notifies","notification","notify"],"sourceVersion":"b7bf02a16a68"},{"kind":"word-form-choice","sourceId":"v1:part5:39:14","wordId":"quote-39","prompt":"I expect the rate that I was ________ over the phone and I will not accept any changes.","answer":"quoted","options":["quoted","quotation","quotable","quotes"],"sourceVersion":"b7bf02a16a68"},{"kind":"word-form-choice","sourceId":"v1:part5:39:15","wordId":"reservation-39","prompt":"Since we had made our ________ so far in advance, we saved considerably on the room rate.","answer":"reservation","options":["reserve","reservation","reserved","reservable"],"sourceVersion":"b7bf02a16a68"}]}
