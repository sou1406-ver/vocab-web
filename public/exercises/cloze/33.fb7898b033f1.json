{"lessonId":33,"version":"fb7898b033f1","questions":[{"kind":"word-form-choice","sourceId":"v1:part5:33:10","wordId":"burden-33","prompt":"George no longer wants to be in charge of lunch orders because he finds that job too ________","answer":"burdensome","options":["burdens","burdened","burden","burdensome"],"sourceVersion":"fb7898b033f1"},{"kind":"word-form-choice","sourceId":"v1:part5:33:11","wordId":"commonly-33","prompt":"we ________ meet the delivery person in the lobby to pick up our orders.","answer":"commonly","options":["common","in common","commonly","commonness"],"sourceVersion":"fb7898b033f1"},{"kind":"word-form-choice","sourceId":"v1:part5:33:12","wordId":"delivery-33","prompt":"The ________ from that restaurant always arrive late.","answer":"deliveries","options":["delivers","deliveries","delivered","delivering"],"sourceVersion":"fb7898b033f1"},{"kind":"word-form-choice","sourceId":"v1:part5:33:13","wordId":"elegance-33","prompt":"Despite being served in disposable containers, the meal had an ________ touch.","answer":"elegant","options":["elegant","elegance","elegantly","elegancy"],"sourceVersion":"fb7898b033f1"},{"kind":"word-form-choice","sourceId":"v1:part5:33:14","wordId":"impress-33","prompt":"Our office manager was so ________ by the speed of the delivery, she decided to order from them again.","answer":"impressed","options":["impressive","impressed","impression","impressionable"],"sourceVersion":"fb7898b033f1"},{"kind":"word-form-choice","sourceId":"v1:part5:33:15","wordId":"individual-33","prompt":"Let's order ________ so we can all get what we want for lunch.","answer":"individually","options":["individualize","individualist","individually","individual"],"sourceVersion":"fb7898b033f1"},{"kind":"cloze-choice","sourceId":"catalog:example:burden-33:0","wordId":"burden-33","prompt":"The secretary usually takes on the ________ of ordering lunch for business meetings.","answer":"burden","options":["burden","delivery","elegance","list"],"sourceVersion":"fb7898b033f1"},{"kind":"cloze-choice","sourceId":"catalog:example:delivery-33:0","wordId":"delivery-33","prompt":"The caterer hired a courier to make the ________.","answer":"delivery","options":["delivery","burden","elegance","list"],"sourceVersion":"fb7898b033f1"},{"kind":"cloze-choice","sourceId":"catalog:example:elegance-33:0","wordId":"elegance-33","prompt":"The ________ of the restaurant made it a pleasant place to eat.","answer":"elegance","options":["elegance","burden","delivery","list"],"sourceVersion":"fb7898b033f1"},{"kind":"cloze-choice","sourceId":"catalog:example:impress-33:1","wordId":"impress-33","prompt":"If you want to ________ the new staff member, order her a nice lunch.","answer":"impress","options":["impress","fall to","narrow","pick up"],"sourceVersion":"fb7898b033f1"},{"kind":"cloze-choice","sourceId":"catalog:example:individual-33:0","wordId":"individual-33","prompt":"We had the delivery man mark the contents of each ________ order.","answer":"individual","options":["individual","multiple","daringly","familiar"],"sourceVersion":"fb7898b033f1"},{"kind":"cloze-choice","sourceId":"catalog:example:list-33:0","wordId":"list-33","prompt":"The office manager compiled a ________ of everyone's order.","answer":"list","options":["list","burden","delivery","elegance"],"sourceVersion":"fb7898b033f1"},{"kind":"cloze-choice","sourceId":"catalog:example:multiple-33:0","wordId":"multiple-33","prompt":"The delivery person was not able to keep track of the ________ order, causing a food mix-up.","answer":"multiple","options":["multiple","individual","daringly","familiar"],"sourceVersion":"fb7898b033f1"},{"kind":"cloze-choice","sourceId":"catalog:example:pick-up-33:1","wordId":"pick-up-33","prompt":"If you ask me nicely, I will ________ the order on my way home.","answer":"pick up","options":["pick up","fall to","impress","narrow"],"sourceVersion":"fb7898b033f1"}]}
