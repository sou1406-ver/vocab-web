{"lessonId":42,"version":"a61d1ab37cb2","questions":[{"kind":"word-form-choice","sourceId":"v1:part5:42:10","wordId":"approach-42","prompt":"The director's creativity showed in everything from her ________ to the literary quality of the play to the costumes and sets.","answer":"approach","options":["approaching","approach","approachable","approachability"],"sourceVersion":"a61d1ab37cb2"},{"kind":"word-form-choice","sourceId":"v1:part5:42:11","wordId":"action-42","prompt":"Edward is a very talented ________ although he can't sing or dance well at all.","answer":"actor","options":["actor","acts","action","acting"],"sourceVersion":"a61d1ab37cb2"},{"kind":"word-form-choice","sourceId":"v1:part5:42:12","wordId":"experience-42","prompt":"As your director, I call upon you to bring your life ________ into your role.","answer":"experience","options":["experienced","experiencing","experiential","experience"],"sourceVersion":"a61d1ab37cb2"},{"kind":"word-form-choice","sourceId":"v1:part5:42:13","wordId":"creative-42","prompt":"I am not ________ enough to work in the theater, but I certainly enjoy attending it.","answer":"creative","options":["create","creativeness","creative","creativity"],"sourceVersion":"a61d1ab37cb2"},{"kind":"word-form-choice","sourceId":"v1:part5:42:14","wordId":"perform-42","prompt":"I look forward to the annual ________ of The Nutcracker ballet.","answer":"performance","options":["performance","performer","perform","performable"],"sourceVersion":"a61d1ab37cb2"},{"kind":"word-form-choice","sourceId":"v1:part5:42:15","wordId":"rehearse-42","prompt":"There isn't much time left to ________ before the play opens.","answer":"rehearse","options":["rehearsals","rehearse","rehearsing","rehearsed"],"sourceVersion":"a61d1ab37cb2"}]}
