{"lessonId":48,"version":"fb65221bd8c9","questions":[{"kind":"word-form-choice","sourceId":"v1:part5:48:10","wordId":"allow-48","prompt":"Office policy does not ________ employees to leave the office for medical appointments.","answer":"allow","options":["allow","allowing","allowable","allowance"],"sourceVersion":"fb65221bd8c9"},{"kind":"word-form-choice","sourceId":"v1:part5:48:11","wordId":"alternative-48","prompt":"You should investigate to see if there are any ________ to costly hospital stays.","answer":"alternatives","options":["alternate","alternatively","alternatives","alternating"],"sourceVersion":"fb65221bd8c9"},{"kind":"word-form-choice","sourceId":"v1:part5:48:12","wordId":"concern-48","prompt":"It ________ me that our company is not willing to look for an alternative to our current health insurance plan.","answer":"concerns","options":["concern","concerned","concerns","concerning"],"sourceVersion":"fb65221bd8c9"},{"kind":"word-form-choice","sourceId":"v1:part5:48:13","wordId":"emphasize-48","prompt":"I'm really pleased that my health plan provider is paying for my gym membership as a way to ________ its concern for my health.","answer":"emphasize","options":["emphasis","emphasize","emphatic","emphasizing"],"sourceVersion":"fb65221bd8c9"},{"kind":"word-form-choice","sourceId":"v1:part5:48:14","wordId":"regardless-48","prompt":"________ health insurance as an indispensable job benefit.","answer":"regard","options":["regardless","regardful","regarding","regard"],"sourceVersion":"fb65221bd8c9"},{"kind":"word-form-choice","sourceId":"v1:part5:48:15","wordId":"suit-48","prompt":"The employee's goal is to find her family ________ health coverage.","answer":"suitable","options":["suit","suitable","suitably","suitability"],"sourceVersion":"fb65221bd8c9"},{"kind":"cloze-choice","sourceId":"catalog:example:allow-48:0","wordId":"allow-48","prompt":"My insurance does not ________ me to choose my own hospital.","answer":"allow","options":["allow","emphasize","incur",