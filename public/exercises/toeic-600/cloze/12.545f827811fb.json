{"lessonId":12,"version":"545f827811fb","questions":[{"kind":"word-form-choice","sourceId":"v1:part5:12:10","wordId":"apply-12","prompt":"So many well-qualified people ________ for the position that we won't be able to make a decision for several weeks.","answer":"applied","options":["apply","application","applicant","applied"],"sourceVersion":"545f827811fb"},{"kind":"word-form-choice","sourceId":"v1:part5:12:11","wordId":"confidence-12","prompt":"As the interview continued, the applicant's ________ began to decline.","answer":"confidence","options":["confidently","confident","confidence","confidential"],"sourceVersion":"545f827811fb"},{"kind":"word-form-choice","sourceId":"v1:part5:12:12","wordId":"expert-12","prompt":"The applicant's unique ________ enabled her to have almost any job that she wanted.","answer":"expertise","options":["expertise","experts","expertly","expert"],"sourceVersion":"545f827811fb"},{"kind":"word-form-choice","sourceId":"v1:part5:12:13","wordId":"hesitant-12","prompt":"She spoke without ________ expressing self-confidence and projecting that she had a firm handle on the information.","answer":"hesitation","options":["hesitant","hesitate","hesitatingly","hesitation"],"sourceVersion":"545f827811fb"},{"kind":"word-form-choice","sourceId":"v1:part5:12:14","wordId":"present-12","prompt":"During an interview, it is important to ________ your weaknesses in a way that shows you are working to improve them.","answer":"present","options":["presentation","present","presentable","presenting"],"sourceVersion":"545f827811fb"},{"kind":"word-form-choice","sourceId":"v1:part5:12:15","wordId":"weakly-12","prompt":"Her handshake had always felt like a dead fish and it was taken as a sign of a ________ character.","answer":"weak","options":["weak","weakly","weakness","weakening"],"sourceVersion":"545f827811fb"},{"kind":"cloze-choice","sourceId":"catalog:example:ability-12:0","wordId":"ability-12","prompt":"The designer's ________ was obvious from her portfolio.","answer":"ability","options":["ability","benefit","success","basis"],"sourceVersion":"545f827811fb"},{"kind":"cloze-choice","sourceId":"catalog:example:apply-12:1","wordId":"apply-12","prompt":"Everyone who is interested should ________ in person at any branch office.","answer":"apply","options":["apply","contribute","bring together","be aware of"],"sourceVersion":"545f827811fb"},{"kind":"cloze-choice","sourceId":"catalog:example:background-12:0","wordId":"background-12","prompt":"Your ________ in the publishing industry is a definite asset for this job.","answer":"background","options":["background","merit","recognition","success"],"sourceVersion":"545f827811fb"},{"kind":"cloze-choice","sourceId":"catalog:example:confidence-12:0","wordId":"confidence-12","prompt":"Good applicants show ________ during an interview.","answer":"confidence","options":["confidence","achievement","qualifications","recognition"],"sourceVersion":"545f827811fb"},{"kind":"cloze-choice","sourceId":"catalog:example:constantly-12:0","wordId":"constantly-12","prompt":"The company is ________ looking for highly trained employees.","answer":"constantly","options":["constantly","productive","set up","loyal"],"sourceVersion":"545f827811fb"},{"kind":"cloze-choice","sourceId":"catalog:example:expert-12:0","wordId":"expert-12","prompt":"Our department head is an ________ in financing.","answer":"expert","options":["expert","background","profile","qualifications"],"sourceVersion":"545f827811fb"},{"kind":"cloze-choice","sourceId":"catalog:example:follow-up-12:0","wordId":"follow-up-12","prompt":"Always ________ an interview with a thank-you note.","answer":"follow up","options":["follow up","contribute","present","compensate"],"sourceVersion":"545f827811fb"},{"kind":"cloze-choice","sourceId":"catalog:example:hesitant-12:0","wordId":"hesitant-12","prompt":"Marla was ________ about negotiating a higher salary.","answer":"hesitant","options":["hesitant","abundant","vested","constantly"],"sourceVersion":"545f827811fb"},{"kind":"cloze-choice","sourceId":"catalog:example:weakly-12:0","wordId":"weakly-12","prompt":"Her hands trembled and she spoke ________ at the interview.","answer":"weakly","options":["weakly","flexibly","delicately","obviously"],"sourceVersion":"545f827811fb"}]}
