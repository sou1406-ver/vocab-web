{"lessonId":35,"version":"f35641b119f0","questions":[{"kind":"word-form-choice","sourceId":"v1:part5:35:10","wordId":"assist-35","prompt":"Do you need our ________ with any of the evening's details?","answer":"assistance","options":["assist","assisting","assistance","assistant"],"sourceVersion":"f35641b119f0"},{"kind":"word-form-choice","sourceId":"v1:part5:35:11","wordId":"coordinate-35","prompt":"The event did not go off well because the ________ did a poor job of organizing it.","answer":"coordinator","options":["coordinator","coordination","coordinated","coordinates"],"sourceVersion":"f35641b119f0"},{"kind":"word-form-choice","sourceId":"v1:part5:35:12","wordId":"general-35","prompt":"________ speaking, the event was poorly organized.","answer":"Generally","options":["General","Generally","Generality","Generalizations"],"sourceVersion":"f35641b119f0"},{"kind":"word-form-choice","sourceId":"v1:part5:35:13","wordId":"ideally-35","prompt":"When the event planner saw the hotel ballroom, she knew that the size wasn't ________ but the price was right.","answer":"ideal","options":["ideal","ideally","idealize","idealist"],"sourceVersion":"f35641b119f0"},{"kind":"word-form-choice","sourceId":"v1:part5:35:14","wordId":"plan-35","prompt":"Joshua quit his job and started his own business as an events ________","answer":"planner","options":["planned","plans","planner","planning"],"sourceVersion":"f35641b119f0"},{"kind":"word-form-choice","sourceId":"v1:part5:35:15","wordId":"regulate-35","prompt":"Like restaurants, caterers are subject to ________ concerning safe food handling.","answer":"regulations","options":["regulate","regulations","regulatory","regulating"],"sourceVersion":"f35641b119f0"},{"kind":"cloze-choice","sourceId":"catalog:example:assist-35:0","wordId":"assist-35","prompt":"Bonnie hired a secretary to ________ her with the many details of the event.","answer":"assist","options":[],"sourceVersion":"f35641b119f0"},{"kind":"cloze-choice","sourceId":"catalog:exampl