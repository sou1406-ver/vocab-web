{"lessonId":2,"version":"77e9a4c216f8","questions":[{"kind":"word-form-choice","sourceId":"v1:part5:2:10","wordId":"attract-2","prompt":"Marketing specialists have conducted extensive studies of what ________ customers to a particular product.","answer":"attracts","options":["attractive","attraction","attracts","attracting"],"sourceVersion":"77e9a4c216f8"},{"kind":"word-form-choice","sourceId":"v1:part5:2:11","wordId":"compare-2","prompt":"Smart shoppers will ________ similar brands of an item before making a decision.","answer":"compare","options":["compare","comparison","comparative","comparable"],"sourceVersion":"77e9a4c216f8"},{"kind":"word-form-choice","sourceId":"v1:part5:2:12","wordId":"satisfaction-2","prompt":"If our work isn't to your ________, please notify us within 60 days.","answer":"satisfaction","options":["satisfy","satisfactory","satisfaction","satisfied"],"sourceVersion":"77e9a4c216f8"},{"kind":"word-form-choice","sourceId":"v1:part5:2:13","wordId":"consume-2","prompt":"Manufacturers like to know what features ________ find useful.","answer":"consumers","options":["consumers","consume","consumption","consumable"],"sourceVersion":"77e9a4c216f8"},{"kind":"word-form-choice","sourceId":"v1:part5:2:14","wordId":"market-2","prompt":"Without good ________, good products can go unsold.","answer":"marketing","options":["market","marketable","marketed","marketing"],"sourceVersion":"77e9a4c216f8"},{"kind":"word-form-choice","sourceId":"v1:part5:2:15","wordId":"competition-2","prompt":"A careful analysis of the ________ products on the market indicated that our product lacked innovation and optional features.","answer":"competing","options":["compete","competing","competed","competition"],"sourceVersion":"77e9a4c216f8"},{"kind":"cloze-choice","sourceId":"catalog:example:competition-2:0","wordId":"competition-2","prompt":"In the ________ for afternoon diners, Hector's has come out on top.","answer":"competition","options":["competition","expiration","session",