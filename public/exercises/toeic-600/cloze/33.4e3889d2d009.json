{"lessonId":33,"version":"4e3889d2d009","questions":[{"kind":"word-form-choice","sourceId":"v1:part5:33:10","wordId":"burden-33","prompt":"George no longer wants to be in charge of lunch orders because he finds that job too ________","answer":"burdensome","options":["burdens","burdened","burden","burdensome"],"sourceVersion":"4e3889d2d009"},{"kind":"word-form-choice","sourceId":"v1:part5:33:11","wordId":"commonly-33","prompt":"we ________ meet the delivery person in the lobby to pick up our orders.","answer":"commonly","options":["common","in common","commonly","commonness"],"sourceVersion":"4e3889d2d009"},{"kind":"word-form-choice","sourceId":"v1:part5:33:12","wordId":"delivery-33","prompt":"The ________ from that restaurant always arrive late.","answer":"deliveries","options":["delivers","deliveries","delivered","delivering"],"sourceVersion":"4e3889d2d009"},{"kind":"word-form-choice","sourceId":"v1:part5:33:13","wordId":"elegance-33","prompt":"Despite being served in disposable containers, the meal had an ________ touch.","answer":"elegant","options":["elegant","elegance","elegantly","elegancy"],"sourceVersion":"4e3889d2d009"},{"kind":"word-form-choice","sourceId":"v1:part5:33:14","wordId":"impress-33","prompt":"Our office manager was so ________ by the speed of the delivery, she decided to order from them again.","answer":"impressed","options":["impressive","impressed","impression","impressionable"],"sourceVersion":"4e3889d2d009"},{"kind":"word-form-choice","sourceId":"v1:part5:33:15","wordId":"individual-33","prompt":"Let's order ________ so we can all get what we want for lunch.","answer":"individually","options":["individualize","individualist","individually","individual"],"sourceVersion":"4e3889d2d009"},{"kind":"cloze-choice","sourceId":"catalog:example:burden-33:0","wordId":"burden-33","prompt":"The secretary usually takes on the ________ of ordering lunch for business meetings.","answer":"burden","options":[],"sourceVersion":"4e3889d2d009"},{"kind":"cloze-choice","sourceId":"catalog:example:commonly-33:0","wordId":"commonly-33","prompt":"The people who work in this building ________ order their lunch from the sandwich shop on the first floor.","answer":"commonly","options":[],"sourceVersion":"4e3889d2d009"},{"kind":"cloze-choice","sourceId":"catalog:example:delivery-33:0","wordId":"delivery-33","prompt":"The caterer hired a courier to make the ________.","answer":"delivery","options":[],"sourceVersion":"4e3889d2d009"},{"kind":"cloze-choice","sourceId":"catalog:example:elegance-33:0","wordId":"elegance-33","prompt":"The ________ of the restaurant made it a pleasant place to eat.","answer":"elegance","options":[],"sourceVersion":"4e3889d2d009"},{"kind":"cloze-choice","sourceId":"catalog:example:impress-33:1","wordId":"impress-33","prompt":"If you want to ________ the new staff member, order her a nice lunch.","answer":"impress","options":[],"sourceVersion":"4e3889d2d009"},{"kind":"cloze-choice","sourceId":"catalog:example:individual-33:0","wordId":"individual-33","prompt":"We had the delivery man mark the contents of each ________ order.","answer":"individual","options":[],"sourceVersion":"4e3889d2d009"},{"kind":"cloze-choice","sourceId":"catalog:example:list-33:0","wordId":"list-33","prompt":"The office manager compiled a ________ of everyone's order.","answer":"list","options":[],"sourceVersion":"4e3889d2d009"},{"kind":"cloze-choice","sourceId":"catalog:example:multiple-33:0","wordId":"multiple-33","prompt":"The delivery person was not able to keep track of the ________ order, causing a food mix-up.","answer":"multiple","options":[],"sourceVersion":"4e3889d2d009"},{"kind":"cloze-choice","sourceId":"catalog:example:pick-up-33:1","wordId":"pick-up-33","prompt":"If you ask me nicely, I will ________ the order on my way home.","answer":"pick up","options":[],"sourceVersion":"4e3889d2d009"}]}
