{
  "name": "vocab-learn",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 5174",
    "data:source": "python tools/build_data.py",
    "data:catalog": "node scripts/build-content.mjs",
    "data": "npm run data:source && npm run data:catalog",
    "validate:content": "node scripts/validate-content.mjs",
    "build": "npm run data:catalog && npm run validate:content && next build",
    "start": "next start --hostname 127.0.0.1 --port 5174",
    "preview": "npm run start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --config vitest.config.ts",
    "e2e": "playwright test --config playwright.config.ts",
    "format:py": "python -m ruff format tools",
    "lint:py": "python -m ruff check tools"
  },
  "dependencies": {
    "@fontsource-variable/noto-serif": "^5.3.0",
    "@mdx-js/loader": "^3.1.0",
    "@mdx-js/react": "^3.1.0",
    "@next/mdx": "16.4.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "firebase": "^12.0.0",
    "lucide-react": "^0.468.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "^3.3.1",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@eslint/js": "^9.15.0",
    "@playwright/test": "1.51.1",
    "@types/node": "^24.0.0",
    "eslint": "^9.15.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^15.12.0",
    "prettier": "^3.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.15.0",
    "vitest": "^2.1.5",
    "@tailwindcss/postcss": "4.3.3",
    "@types/mdx": "^2.0.13",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "postcss": "^8.5.6",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "^1.3.0"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.13.6"
  },
  "description": "Vocab Learn — Next.js app, content and tests"
}
